# Puerto HTTP del panel web
PORT=3055

# Puerto SSH de Termux (por defecto 8022)
SSH_PORT=8022

# Host ADB local dentro del dispositivo (y remoto opcional para desarrollo en PC)
ADB_HOST_LOCAL=127.0.0.1:5555
ADB_HOST_REMOTE=127.0.0.1:5555

# Etiqueta de fuente de energía mostrada en el panel
POWER_SOURCE=UPS 5V (24/7)

# Cantidad de puntos en el historial en memoria y caché de lecturas (ms)
HISTORY_MAX_POINTS=20
CACHE_TTL_MS=2000

# Control de acceso: NO escribir a mano. Se generan con "npm run set-password"
# AUTH_PASSWORD_HASH=scrypt$<salt>$<hash>
# SESSION_SECRET=<se genera automáticamente al primer arranque>
SESSION_DAYS=7

# Opcionales: si se dejan comentados, el servidor los autodetecta con getprop / os / pm2
# DEVICE_NAME=
# SOC_NAME=
# OS_NAME=
# SERVER_IP=
# TUNNEL_URL=
